{
  "name": "remark-pdfmake",
  "version": "0.1.0",
  "description": "A unified-based pipeline that converts Markdown into pdfmake's TDocumentDefinitions and renders it straight to PDF bytes",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_ja.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "verify:nodenext": "node scripts/verify-nodenext.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iret-m-nakamura/remark-pdfmake.git"
  },
  "homepage": "https://github.com/iret-m-nakamura/remark-pdfmake#readme",
  "bugs": {
    "url": "https://github.com/iret-m-nakamura/remark-pdfmake/issues"
  },
  "keywords": [
    "markdown",
    "pdf",
    "pdfmake",
    "unified",
    "remark",
    "remark-plugin",
    "rehype"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "しろうさ (shirousa)",
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.2",
    "@types/pdfmake": "^0.3.3",
    "@types/unist": "^3.0.3",
    "fontkit": "^2.0.4",
    "hast-util-to-text": "^4.0.2",
    "pdfmake": "^0.3.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "pdf-lib": "^1.17.1",
    "remark": "^15.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unist-util-assert": "^4.0.0"
  }
}
